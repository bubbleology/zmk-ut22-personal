#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define BLE 1
// -----------------

/ {

	keymap {
		compatible = "zmk,keymap";

		// LAYER: BASE 0
		default_layer {
			label = "Base";
			bindings = <
			&kp R &kp S &kp N &kp I   
			&kp A &kp O &kp T &kp E
			&kp Z       &kp RALT &kp SPACE 
			&kp R &kp S &kp N &kp I
            &kp A &kp O &kp T &kp E
            &kp Z       &kp RALT &kp SPACE   
			>;
		};

        // LAYER: BLE 1
		ble_layer {
			label = "BLE";
			bindings = <
			&BT_SEL 0 &BT_SEL 1 &BT_SEL 2 &BT_SEL 3   
			&none &none &none &BT_CLR
			&none       &none &none   
			&none &none &none &none
            &none &none &none &none
            &none       &none &none        
			>;
		};
    };
};